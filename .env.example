# Application Settings
APP_NAME="Pulse Server API"
APP_ENV="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"
FRONTEND_URL="http://localhost:4200"
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:4200","http://localhost:8000"]


# Security & JWT
JWT_SECRET_KEY="pulse_super_secret_jwt_token_key_change_in_prod_12345"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100

# Cloudflare R2 Upload Validation
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_UPLOAD_MIME_TYPES=["image/jpeg","image/png","image/webp","image/gif","application/pdf","application/zip"]

# MySQL Database Configuration
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="tracker_user"
MYSQL_PASSWORD="tracker_password"
MYSQL_DATABASE="tracker_db"

# Cloudflare R2 Object Storage Configuration
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="tracker-bucket"
R2_ENDPOINT_URL="https://<your_account_id>.r2.cloudflarestorage.com"
R2_PUBLIC_CUSTOM_DOMAIN="https://pub-<hash>.r2.dev"

# SMTP Email Configuration (Pulse branding)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASSWORD="your_email_app_password"
SMTP_FROM_EMAIL="noreply@pulse.io"
SMTP_FROM_NAME="Pulse"
SMTP_TLS=True
SMTP_SSL=False
